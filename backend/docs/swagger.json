        "role": { "type": "string", "enum": ["TENANT_ADMIN", "TENANT_OPERATOR", "VIEWER"], "example": "TENANT_OPERATOR" }
      }
    },
    "CreateBranchRequest": {
      "type": "object",
      "required": ["branch_code", "name", "address", "city", "country", "latitude", "longitude"],
      "properties": {
        "branch_code": { "type": "string", "example": "DEL-HUB-01" },
        "name": { "type": "string", "example": "Delhi North Hub" },
        "address": { "type": "string", "example": "Plot 42, GT Karnal Road" },
        "city": { "type": "string", "example": "New Delhi" },
        "state": { "type": "string", "example": "Delhi" },
        "postal_code": { "type": "string", "example": "110033" },
        "country": { "type": "string", "example": "India" },
        "latitude": { "type": "number", "example": 28.7041 },
        "longitude": { "type": "number", "example": 77.1025 },
        "coverage_radius_km": { "type": "number", "example": 25.0 }
      }
    },
    "UpdateBranchRequest": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "coverage_radius_km": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "SUSPENDED"] }
