# ==============================================================================
# LogiFlows Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# DO NOT commit real credentials or production secrets to version control.
# ==============================================================================

# Application Configuration
APP_NAME=logiflows-api
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=debug

# Request & Observability
REQUEST_ID_HEADER=X-Request-ID

# Database (PostgreSQL + PostGIS)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_dev_password
DATABASE_NAME=logiflows_dev
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=15m

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & Authentication (JWT & Session Tokens)
JWT_SECRET=super-secret-logiflows-dev-jwt-key-min32chars!
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h
JWT_ISSUER=logiflows-api

# CORS & Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

